# Copy this file to ".env" and change the secrets.
PORT=
NODE_ENV=
MONGO_URI=
CLIENT_URL=http://localhost:5173

# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
